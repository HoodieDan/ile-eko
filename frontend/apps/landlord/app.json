{
  "expo": {
    "name": "Ilé Èkó",
    "slug": "ile-eko",
    "scheme": "ileeko",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F1EDE4",
    "newArchEnabled": true,
    "updates": {
      "url": "https://u.expo.dev/f6b31e93-9b6a-4f53-bd57-2c319a9243f1",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "splash": {
      "backgroundColor": "#0F3D2E",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ileeko.landlord",
      "userInterfaceStyle": "light"
    },
    "android": {
      "package": "com.ileeko.landlord"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Ilé Èkó needs your photo library to attach property photos and payment receipts."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "f6b31e93-9b6a-4f53-bd57-2c319a9243f1"
      }
    }
  }
}
