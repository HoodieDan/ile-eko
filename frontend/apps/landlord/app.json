{
  "expo": {
    "name": "Ilé Èkó",
    "slug": "ile-eko",
    "scheme": "ileeko",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F1EDE4",
    "newArchEnabled": true,
    "updates": {
      "url": "https://u.expo.dev/4b75de0d-49bc-4b57-b3be-98d3dd0cdbfa",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ileeko.landlord",
      "userInterfaceStyle": "light",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.ileeko.landlord"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F3D2E"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Ilé Èkó needs your photo library to attach property photos and payment receipts."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "4b75de0d-49bc-4b57-b3be-98d3dd0cdbfa"
      }
    }
  }
}
