{
  "expo": {
    "name": "Ilé Èkó Homes",
    "slug": "ile-eko-homes",
    "scheme": "ileekohomes",
    "version": "0.1.1",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#ECEEF6",
    "newArchEnabled": true,
    "updates": {
      "url": "https://u.expo.dev/5807abab-fa24-4bd7-acaa-ffcefa68f315",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ileeko.homes",
      "userInterfaceStyle": "light",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.ileeko.homes",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#171B45"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#171B45"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "5807abab-fa24-4bd7-acaa-ffcefa68f315"
      }
    },
    "icon": "./assets/icon.png"
  }
}
