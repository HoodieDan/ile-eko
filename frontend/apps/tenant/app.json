{
  "expo": {
    "name": "Ilé Èkó Homes",
    "slug": "ile-eko-homes",
    "scheme": "ileekohomes",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#ECEEF6",
    "newArchEnabled": true,
    "updates": {
      "url": "https://u.expo.dev/5807abab-fa24-4bd7-acaa-ffcefa68f315",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "splash": {
      "backgroundColor": "#171B45",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ileeko.homes",
      "userInterfaceStyle": "light",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.ileeko.homes"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "5807abab-fa24-4bd7-acaa-ffcefa68f315"
      }
    }
  }
}
