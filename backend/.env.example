# --- Core ---
NODE_ENV=development
PORT=4000                     # Cloud Run overrides this; app binds process.env.PORT ?? 4000
MONGODB_URI=mongodb://127.0.0.1:27017/ile-eko
MONGO_MAX_POOL_SIZE=8         # per instance; keep instances × pool < Atlas connection limit

# --- Auth (per-device Session model, §8) ---
JWT_SECRET=change-me-in-prod-please-32-chars-min
JWT_EXPIRES_IN=7d            # short access token; per-device Session revocation
SESSION_SLIDING=true         # refresh lastSeenAt on use

# --- AI (M5) ---
AI_PROVIDER=openai           # openai | anthropic
AI_MODEL=gpt-4o              # pin the current GA model at M5
AI_API_KEY=
AI_TIMEOUT_MS=30000

# --- Storage (M2/M6) ---
GCS_PUBLIC_BUCKET=ile-eko-public
GCS_PRIVATE_BUCKET=ile-eko-private
GCS_PROJECT_ID=

# --- Notifications / providers (M6) ---
EXPO_ACCESS_TOKEN=
RESEND_API_KEY=
TERMII_API_KEY=
EMAIL_FROM=no-reply@ile-eko.app

# --- Ops ---
TASKS_SERVICE_ACCOUNT=
CORS_ORIGINS=http://localhost:8081
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
LOG_LEVEL=info
